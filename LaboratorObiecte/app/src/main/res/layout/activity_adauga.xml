<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="8dp"
            app:cardUseCompatPadding="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Adauga o Drona Noua"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="#333333"
                    android:gravity="center"
                    android:layout_marginBottom="20dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Model Drona:"
                    android:textStyle="bold"
                    android:textColor="#555555" />

                <EditText
                    android:id="@+id/etModel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Ex: DJI Mavic"
                    android:layout_marginBottom="12dp"
                    android:backgroundTint="#6200EE" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Autonomie (minute):"
                    android:textStyle="bold"
                    android:textColor="#555555" />

                <EditText
                    android:id="@+id/etAutonomie"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:hint="Ex: 30"
                    android:layout_marginBottom="12dp"
                    android:backgroundTint="#6200EE" />

                <CheckBox
                    android:id="@+id/cbCamera"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Are camera?"
                    android:textColor="#333333"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Culoare:"
                    android:textStyle="bold"
                    android:textColor="#555555" />

                <Spinner
                    android:id="@+id/spinnerCuloare"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Rating:"
                    android:textStyle="bold"
                    android:textColor="#555555" />

                <RatingBar
                    android:id="@+id/ratingBar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:numStars="5"
                    android:stepSize="1"
                    android:layout_marginBottom="12dp" />

                <Switch
                    android:id="@+id/swPornita"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Este pornita?"
                    android:textColor="#333333"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tip:"
                    android:textStyle="bold"
                    android:textColor="#555555" />

                <RadioGroup
                    android:id="@+id/rgTip"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="20dp">

                    <RadioButton
                        android:id="@+id/rbMica"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Mica"
                        android:layout_marginEnd="16dp" />

                    <RadioButton
                        android:id="@+id/rbMare"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Mare" />
                </RadioGroup>

                <Button
                    android:id="@+id/btnSalveaza"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Salveaza Drona"
                    android:textSize="16sp"
                    android:backgroundTint="#6200EE"
                    android:textColor="#FFFFFF" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>
</ScrollView>